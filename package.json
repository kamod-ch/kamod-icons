{
  "name": "kamod-icons",
  "version": "2.0.0",
  "private": true,
  "description": "Lightweight, tree-shakeable SVG icon library for Preact apps.",
  "keywords": [
    "preact",
    "icons",
    "svg-icons",
    "icon-library",
    "typescript",
    "tree-shaking",
    "tree-shakeable",
    "preact-components",
    "ui-components",
    "design-system",
    "kamod-ui",
    "kamod-icons",
    "preactpress",
    "figma-icons",
    "npm-package",
    "monorepo",
    "frontend",
    "webdev",
    "developer-tools",
    "shadcn"
  ],
  "homepage": "https://kamod-ch.github.io/kamod-icons/",
  "bugs": {
    "url": "https://github.com/kamod-ch/kamod-icons/issues"
  },
  "license": "MIT",
  "author": "Klaus Zahiragic <watzak>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamod-ch/kamod-icons.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@kamod-ch/brand": "^0.4.0",
    "@typescript/typescript6": "^6.0.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0"
  },
  "scripts": {
    "prepublishOnly": "node -e \"console.error('Do not publish the workspace root. Use: pnpm publish:core'); process.exit(1)\"",
    "icons:sync": "pnpm --filter @kamod-ch/icons icons:sync",
    "icons:generate": "pnpm --filter @kamod-ch/icons icons:generate",
    "build:icons": "pnpm --filter @kamod-ch/icons build",
    "build:docs": "pnpm --filter @kamod-ch/icons-docs build",
    "build": "pnpm run build:icons && pnpm run build:docs",
    "dev:icons": "pnpm --filter @kamod-ch/icons dev",
    "docs:dev": "pnpm --filter @kamod-ch/icons-docs dev",
    "check:docs": "pnpm --filter @kamod-ch/icons-docs check",
    "docs:preview": "pnpm --filter @kamod-ch/icons-docs preview",
    "clean": "pnpm --filter @kamod-ch/icons clean && rm -rf packages/docs/dist",
    "brand:readme": "kamod-brand-readme --product Icons --output .github/assets",
    "pack:core": "pnpm --filter @kamod-ch/icons exec npm pack --dry-run",
    "publish:core": "pnpm --filter @kamod-ch/icons publish --access public",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:check": "pnpm build && pnpm check:docs",
    "release:rc-check": "node ./scripts/release-candidate-check.mjs",
    "release:publish": "pnpm --filter @kamod-ch/icons publish --access public --provenance --no-git-checks",
    "release": "node ./scripts/release.mjs patch",
    "release:minor": "node ./scripts/release.mjs minor",
    "release:major": "node ./scripts/release.mjs major",
    "release:dry": "node ./scripts/release.mjs patch --dry",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "pnpm --filter @kamod-ch/icons test",
    "typecheck": "pnpm --filter @kamod-ch/icons typecheck"
  }
}
